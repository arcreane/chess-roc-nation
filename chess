# 1 position

class Position:
   def __init__(self, column, row):
       #enregistre la colonne ('a' à 'h') et la ligne (1 à 8)
       self._column = column
       self._row = row

   @property
   def column(self):
       return self._column

   @property
   def row(self):
       return self._row

   def __str__(self):
       # affiche position
       return str(self._column) + str(self._row)

